{
  "name": "etape-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run --project chart-core && vitest run --project chart-panel && npm run test:golden && vitest run src/chrome/panels/LadderPanel.test.tsx && vitest run src/chrome/panels/TapePanel.test.tsx",
    "test:watch": "vitest",
    "test:golden": "vitest run test/golden/harness.golden.test.ts && vitest run test/golden/ladder.golden.test.ts && vitest run test/golden/tape.golden.test.ts",
    "test:golden:update": "UPDATE_GOLDENS=1 vitest run test/golden/harness.golden.test.ts && UPDATE_GOLDENS=1 vitest run test/golden/ladder.golden.test.ts && UPDATE_GOLDENS=1 vitest run test/golden/tape.golden.test.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "mock-engine": "tsx mock-engine/run.ts",
    "capture": "tsx mock-engine/capture.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "dockview": "^7.0.4",
    "dockview-react": "^7.0.4",
    "lightweight-charts": "^5.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.0",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^6.0.5",
    "canvas": "^3.2.3",
    "dockview-core": "7.0.4",
    "eslint": "^10.8.0",
    "jsdom": "^30.0.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "ws": "^8.21.0"
  }
}
